# Copy to .env (never commit .env). No secrets live here: the password is
# set with `docker compose exec laner python -m app.cli set-password`
# and stored only as an Argon2id hash in the database.

# Time zone, so "today" and backup times are local.
TZ=Europe/London

# Host port the app listens on (127.0.0.1 only). Change if 8000 is taken.
LANER_PORT=8000

# Nightly backups: hour of day (0-23) and how many to keep.
BACKUP_HOUR=3
BACKUP_KEEP=14
