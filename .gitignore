# --- Python --------------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Secrets / local config: NEVER commit --------------------------------
.env
.env.*
!.env.example

# --- Runtime data: NEVER commit -----------------------------------------
# The SQLite database holds real financial data. Ignore every DB file in
# data/, plus SQLite's side files, which contain that same data:
#   -journal  rollback journal (default mode)
#   -wal      write-ahead log (if WAL mode is enabled later)
#   -shm      shared-memory index for WAL
# data/.gitkeep is re-included so the folder itself exists after a clone.
data/*
!data/.gitkeep

# Belt and braces: a stray DB anywhere else in the tree is ignored too.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Editors / OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
